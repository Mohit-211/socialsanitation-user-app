# Copy this file to .env and fill in the values. .env is git-ignored.
# react-native-config reads these at build time, so rebuild the app
# (not just reload Metro) after changing them. Every value here ends up
# inside the app, so never put passwords or private keys in this file.

# Base URL of the Social Sanitation API (version 2), without a trailing slash.
# Production: https://api.socialsanitation.com/api/v2
# Use a staging server while testing, so test data stays out of production.
API_BASE_URL=
